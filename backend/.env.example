# Copy to backend/.env and fill in. Never commit .env.

# LiteLLM (on-prem, plain HTTP). A trailing /v1 is added if missing.
LITELLM_BASE_URL=http://172.17.58.139:4000/v1
# Your dedicated LiteLLM virtual key (starts with sk-)
LITELLM_API_KEY=

# Models
CHAT_MODEL=qwen3.8
EMBEDDING_MODEL=llama-nemotron-embed-1b-v2
# Comma-separated model ids offered in the UI (empty = only CHAT_MODEL)
ALLOWED_MODELS=qwen3.8

# Limits: the model accepts 262144 tokens; the working budget is smaller on purpose
MAX_CONTEXT_TOKENS=262144
CONTEXT_BUDGET_TOKENS=32768
MAX_OUTPUT_TOKENS=8192

# Local service (the app has no login, so HOST must stay on this computer)
HOST=127.0.0.1
PORT=8000
DATA_DIR=data

# The model writes a short title for a chat after its first answer (true/false)
# AUTO_TITLES=true
